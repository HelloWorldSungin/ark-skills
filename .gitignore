.worktrees/

# Ark workflow chain state (per-project ongoing work) — ignore files but
# not the directory itself, so exceptions below can re-include specific
# subdirectories like audit reports.
.ark-workflow/*
# Exception: audit reports are durable artifacts — track them.
!.ark-workflow/audits
!.ark-workflow/audits/**

.omc/
# Exception: test fixtures that intentionally ship a fake .omc/ tree
!skills/wiki-update/scripts/fixtures/**/.omc/
!skills/wiki-update/scripts/fixtures/**/.omc/**

# gstack runtime state (deploy reports, sessions, analytics) — machine-local
.gstack/

# Python bytecode cache
**/__pycache__/

# graphify — track graph.json + manifest.json; ignore regenerable/local output
graphify-out/cache/
graphify-out/cost.json
graphify-out/GRAPH_REPORT.md
graphify-out/graph.html
graphify-out/.graphify_root
graphify-out/.graphify_labels.json
# dated per-run snapshot dirs (e.g. graphify-out/2026-06-16/)
graphify-out/????-??-??/
